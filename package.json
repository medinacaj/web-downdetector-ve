{
  "name": "pulsove",
  "version": "0.1.0",
  "private": true,
  "description": "PulsoVE — plataforma independiente de monitoreo ciudadano y técnico de servicios en Venezuela",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "drizzle-kit push",
    "db:migrate:deploy": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "create-admin": "tsx scripts/create-admin.ts",
    "aggregate:run": "tsx scripts/aggregate-cron.ts",
    "dev:synthetic-traffic": "tsx scripts/dev-synthetic-traffic.ts",
    "db:generate": "drizzle-kit generate",
    "test:unit": "vitest run --exclude tests/api-reports.test.ts",
    "test:integration": "vitest run tests/api-reports.test.ts",
    "check:schema": "tsx scripts/check-schema.ts",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "check:standards": "npm run lint && npm run check:schema && npm run check:migrations && npm run check:docs",
    "docs:data": "tsx scripts/data-dictionary.ts",
    "check:docs": "tsx scripts/data-dictionary.ts --check"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "next": "^16.3.0",
    "postgres": "^3.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^2.12.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/ui": "^2.1.2",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
