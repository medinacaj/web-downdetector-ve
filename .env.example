# --- Base de datos ---
DATABASE_URL="postgresql://pulsove:pulsove_dev_pw@localhost:5432/pulsove_dev"

# --- Dominio y SEO (src/lib/seo/site.ts) ---
# Origen canónico, sin barra final ni ruta. Aún no hay dominio: en local vale
# este; en producción, el dominio definitivo con https. Definir SITE_URL y
# SITE_INDEXING también durante `npm run build` (la 404 se genera en el build).
SITE_URL="http://localhost:3000"
# Política de indexación (decisión del 2026-10-11, opción A): "false" = noindex
# global y sitemap vacío mientras los datos sean demostrativos. Para abrir la
# indexación: "true" + SITE_URL público con https (si no, sigue en noindex).
SITE_INDEXING="false"

# --- Panel de administración (Etapa 6: src/lib/auth/) ---
# Sesiones guardadas en la base (cookie httpOnly con un token aleatorio; en la base
# solo su hash) y segundo factor TOTP obligatorio. JWT_SECRET ya no se usa para las
# sesiones; se conserva por compatibilidad con .env existentes.
JWT_SECRET="reemplazar-con-un-secreto-largo-y-aleatorio-en-produccion"
SESSION_COOKIE_NAME="pulsove_session"
# Clave AES-256 (64 caracteres hex) para cifrar los secretos TOTP en la base. Genérala
# con `openssl rand -hex 32`. Si se pierde, cada administrador tendrá que volver a dar de
# alta su segundo factor (npm run create-admin -- --email … --reset).
ADMIN_ENCRYPTION_KEY="reemplazar-con-64-caracteres-hex"

# --- Redis (opcional). Si se deja vacío, rate limiting y eventos en tiempo
#     real usan implementaciones en memoria (válidas para una sola instancia).
REDIS_URL=""

# --- Hashing de identidad anónima / IP ---
# Secreto rotativo usado para generar anonymous_hash e ip_prefix_hash.
# Ver lib/privacy.ts — políticas de retención en README > Privacidad.
ANONYMIZATION_SALT="reemplazar-con-otro-secreto-aleatorio"

# --- Anti-abuso (Etapa 5: src/lib/security/turnstile.ts) ---
# Cloudflare Turnstile en el formulario de reporte. Desactivado por defecto. Con "true"
# hacen falta las dos claves del panel de Cloudflare (la secreta, solo en el entorno del
# servidor, nunca en el repositorio); si faltan o Cloudflare no responde, los reportes
# se rechazan (falla cerrada). El servidor necesita salida a challenges.cloudflare.com.
ENABLE_TURNSTILE="false"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Mediciones técnicas ---
# Deshabilitado por defecto para no ejecutar sondeos automáticos contra
# dominios de terceros sin necesidad real. Ver README > Mediciones técnicas.
ENABLE_TECHNICAL_CHECKS="false"

# --- Zona horaria de negocio (cálculo de línea base por día/hora) ---
APP_TIMEZONE="America/Caracas"

# --- Pesos del motor de anomalías (deben sumar 1.0) ---
WEIGHT_DEVIATION="0.40"
WEIGHT_UNIQUE_SOURCES="0.20"
WEIGHT_PERSISTENCE="0.15"
WEIGHT_GEO_DISPERSION="0.10"
WEIGHT_TECHNICAL="0.10"
WEIGHT_OFFICIAL="0.05"

# Límite de reportes por identidad anónima (brief, sección 11.1). Un límite
# más amplio por prefijo de IP y detección de campañas coordinadas llegan
# en la Etapa 7 — esto es solo el límite básico por dispositivo.
RATE_LIMIT_REPORTS_MAX="5"
RATE_LIMIT_REPORTS_WINDOW_SECONDS="3600"

# Motor de anomalías e incidentes (brief, secciones 9.1, 9.5, 9.7)
BASELINE_LOOKBACK_DAYS="90"
# Umbral de apertura = piso de "posible interrupción" (banda 55-69,
# sección 9.6); cierre una banda por debajo para evitar parpadeo.
INCIDENT_OPEN_CONFIDENCE="55"
INCIDENT_CLOSE_CONFIDENCE="40"
INCIDENT_MIN_CONSECUTIVE_WINDOWS="2"
INCIDENT_MIN_UNIQUE_REPORTERS="2"
